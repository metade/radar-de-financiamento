#!/usr/bin/env ruby

require "date"
require "optparse"
require_relative "../lib/funding_radar"

root = File.expand_path("..", __dir__)
options = {tenders_per_source: ENV["REPORT_TENDERS_PER_SOURCE"]}
OptionParser.new do |parser|
  parser.banner = "Usage: generate_report [options]"
  parser.on("--debug", "Log fetched URLs, pipeline stages, and LLM activity") do
    ENV["FUNDING_RADAR_DEBUG"] = "true"
  end
  parser.on("--tenders-per-source N", Integer, "Limit opportunities sampled from each source") do |value|
    options[:tenders_per_source] = value
  end
end.parse!

today = ENV.fetch("REPORT_DATE", Date.today.iso8601)
report_mode = ENV.fetch("REPORT_MODE", "production")
processing_mode = ENV.fetch("REPORT_PROCESSING", report_mode == "production" ? "both" : "deterministic")
unless %w[deterministic source_config both].include?(processing_mode)
  abort "Unsupported REPORT_PROCESSING=#{processing_mode.inspect}; use deterministic, source_config or both"
end
report_filename = case report_mode
when "production"
  nil
when "development"
  "latest.md"
else
  abort "Unsupported REPORT_MODE=#{report_mode.inspect}; use production or development"
end

llm_cache_dir = FundingRadar::LlmProcessing::Cache.directory(root: root)
llm_cache = FundingRadar::LlmProcessing::Cache.new(directory: llm_cache_dir)

registry = FundingRadar::SourceRegistry.new(
  sources: FundingRadar::SourceBuilder.default(root: root)
)
llm_processor = if processing_mode != "deterministic" && ENV.fetch("FUNDING_RADAR_LLM", "disabled") == "enabled"
  configuration = FundingRadar::LlmProcessing::Configuration.new(
    path: File.join(root, "data/llm_processing.yml")
  )
  FundingRadar::LlmProcessing::Processor.new(
    configuration: configuration,
    cache: llm_cache,
    client: FundingRadar::LlmProcessing::RubyLlmClient.new
  )
end
if processing_mode != "deterministic" && llm_processor.nil?
  warn "[funding-radar] LLM processing is not active: set FUNDING_RADAR_LLM=enabled"
end
if llm_processor
  warning_days = Integer(ENV.fetch("FUNDING_RADAR_LLM_CACHE_WARN_AFTER_DAYS", "7"))
  latest_cache_at = llm_cache.latest_modified_at
  if warning_days.positive? && latest_cache_at && latest_cache_at < Time.now - (warning_days * 24 * 60 * 60)
    age_days = ((Time.now - latest_cache_at) / (24 * 60 * 60)).floor
    warn "[funding-radar] LLM cache is #{age_days} days old (last entry #{latest_cache_at.strftime('%Y-%m-%d')}); consider running bin/pull_llm_cache"
  end
end
generator = FundingRadar::ReportGenerator.new(
  source_registry: registry,
  duplicate_resolver: FundingRadar::DuplicateResolver.new,
  scorer: FundingRadar::RelevanceScorer.new,
  reports_dir: File.join(root, "_reports"),
  filename: report_filename,
  llm_processor: llm_processor,
  processing_mode: processing_mode
)

path = generator.generate(
  today: Date.iso8601(today),
  tenders_per_source: options[:tenders_per_source]
)
puts "Generated #{path}"
