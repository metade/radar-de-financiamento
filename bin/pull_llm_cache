#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cache_dir="${FUNDING_RADAR_LLM_CACHE_DIR:-tmp/cache/funding_radar_llm}"
if [[ "$cache_dir" != /* ]]; then
  cache_dir="$root/$cache_dir"
fi

command -v gh >/dev/null 2>&1 || { echo "GitHub CLI (gh) is required; install it and run gh auth login." >&2; exit 1; }
if ! gh auth status >/dev/null 2>&1; then
  echo "GitHub CLI is not authenticated; run gh auth login." >&2
  exit 1
fi

workflow="pages.yml"
artifact="funding-radar-llm-cache"
run_id="$(gh run list --workflow "$workflow" --branch main --status success --limit 1 --json databaseId --jq '.[0].databaseId')"
if [[ -z "$run_id" || "$run_id" == "null" ]]; then
  echo "No successful main run was found; leaving the local LLM cache unchanged."
  exit 0
fi

download_dir="$(mktemp -d)"
trap 'rm -rf "$download_dir"' EXIT
if ! gh run download "$run_id" --name "$artifact" --dir "$download_dir"; then
  echo "The $artifact artifact is unavailable or expired; leaving the local LLM cache unchanged."
  exit 0
fi

mkdir -p "$cache_dir"
cp -R "$download_dir"/. "$cache_dir"/
echo "Restored $artifact from successful main run $run_id into $cache_dir."
